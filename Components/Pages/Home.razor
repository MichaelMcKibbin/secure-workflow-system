@page "/"

<PageTitle>Home</PageTitle>

<div class="hero-section">
    <h1>Welcome to SecFlo, the Secure Workflow System</h1>
    <p>Streamline your workflow with secure, efficient case management and approval workflows. Manage cases, track statuses, and collaborate seamlessly with your team.</p>
    <div>
        <a href="/cases" class="btn btn-accent me-2">View Cases</a>
        <a href="/cases/create" class="btn btn-outline-primary text-white ms-2">Create New Case</a>
        <a href="/auth" class="btn btn-outline-secondary text-white ms-2">Authentication Status</a>
    </div>
    
</div>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card fade-in">
            <NavLink href="/cases" class="card fade-in text-decoration-none" role="button">
                <div class="card-header">
                    <h5 class="card-title">📋 Case Management</h5>
                </div>
                <div class="card-body">
                    <p>Efficiently manage and organize your cases with our intuitive workflow system. Track all case details, assignments, and status updates in one centralized location.</p>
                </div>
            </NavLink>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card fade-in">
            <NavLink href="/aboutsecurity" class="card fade-in text-decoration-none" role="button">
                <div class="card-header">
                    <h5 class="card-title">🔒 Security First</h5>
                </div>
                <div class="card-body">
                    <p>Your data security is our priority. Built with enterprise-grade security features including secure authentication and data protection.</p>
                </div>
            </NavLink>
        </div>
    </div>
</div>
