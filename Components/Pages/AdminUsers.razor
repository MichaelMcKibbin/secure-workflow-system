@page "/admin/users"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using secure_workflow_system.Data
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>Manage Users</PageTitle>

<div class="section-header">
    <h2>Manage Users</h2>
    <p class="section-subheader">Approve new users and manage roles</p>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

@if (_approvedRows is null || _pendingRows is null)
{
    <p>Loading...</p>
}
else
{
    <div class="card mb-4 fade-in">
        <div class="card-header">
            <h5 class="card-title mb-0">⏳ Pending Approvals</h5>
        </div>
        <div class="card-body">
            @if (_pendingRows.Count == 0)
            {
                <p class="text-muted"><em>No pending users.</em></p>
            }
            else
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Email Confirmed</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _pendingRows)
                        {
                            <tr>
                                <td>@row.Email</td>
                                <td>
                                    @if (row.EmailConfirmed)
                                    {
                                        <span class="badge badge-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">Pending</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => ApproveUserAsync(row.UserId)">✓ Approve</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card fade-in">
        <div class="card-header">
            <h5 class="card-title mb-0">👥 Approved Users</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Email Confirmed</th>
                        <th>Current Roles</th>
                        <th>Set Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _approvedRows)
                    {
                        <tr>
                            <td>@row.Email</td>
                            <td>
                                @if (row.EmailConfirmed)
                                {
                                    <span class="badge badge-success">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Pending</span>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(row.CurrentRolesDisplay))
                                {
                                    <span class="badge badge-secondary">User</span>
                                }
                                else
                                {
                                    @foreach (var role in row.CurrentRolesDisplay.Split(", "))
                                    {
                                        <span class="badge badge-info me-1">@role</span>
                                    }
                                }
                            </td>
                            <td>
                                <EditForm Model="row" OnValidSubmit="() => UpdateRoleAsync(row)" FormName="@($"ManageUserRole_{row.UserId}")">
                                    <div class="input-group input-group-sm">
                                        <InputSelect class="form-select" @bind-Value="row.SelectedRole">
                                            @foreach (var role in _roles)
                                            {
                                                <option value="@role">@role</option>
                                            }
                                        </InputSelect>
                                        <button type="submit" class="btn btn-primary">Save</button>
                                    </div>
                                </EditForm>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private static readonly string[] _allowedRoles = ["User", "Staff", "Admin"];
    private List<string> _roles = [];
    private List<UserRoleRow>? _approvedRows;
    private List<UserRoleRow>? _pendingRows;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        var configuredRoles = await RoleManager.Roles
            .Where(r => r.Name != null && _allowedRoles.Contains(r.Name))
            .Select(r => r.Name!)
            .ToListAsync();

        _roles = configuredRoles.Count > 0
            ? configuredRoles.OrderBy(r => Array.IndexOf(_allowedRoles, r)).ToList()
            : _allowedRoles.ToList();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _approvedRows = [];
        _pendingRows = [];

        var users = await UserManager.Users
            .OrderBy(u => u.Email)
            .ToListAsync();

        foreach (var user in users)
        {
            var userRoles = await UserManager.GetRolesAsync(user);
            var appRoles = userRoles.Where(r => _allowedRoles.Contains(r)).ToList();

            var row = new UserRoleRow
            {
                UserId = user.Id,
                Email = user.Email ?? user.UserName ?? user.Id,
                EmailConfirmed = user.EmailConfirmed,
                CurrentRolesDisplay = appRoles.Count > 0 ? string.Join(", ", appRoles) : "None",
                SelectedRole = appRoles.Contains("Admin")
                    ? "Admin"
                    : appRoles.FirstOrDefault() ?? "User"
            };

            if (user.IsApproved)
            {
                _approvedRows.Add(row);
            }
            else
            {
                _pendingRows.Add(row);
            }
        }
    }

    private async Task ApproveUserAsync(string userId)
    {
        _message = null;

        var user = await UserManager.FindByIdAsync(userId);
        if (user is null)
        {
            _message = "User not found.";
            _isError = true;
            return;
        }

        user.IsApproved = true;
        user.EmailConfirmed = true;

        var updateResult = await UserManager.UpdateAsync(user);
        if (!updateResult.Succeeded)
        {
            _message = string.Join(", ", updateResult.Errors.Select(e => e.Description));
            _isError = true;
            return;
        }

        if (!await UserManager.IsInRoleAsync(user, "User"))
        {
            var addRoleResult = await UserManager.AddToRoleAsync(user, "User");
            if (!addRoleResult.Succeeded)
            {
                _message = string.Join(", ", addRoleResult.Errors.Select(e => e.Description));
                _isError = true;
                return;
            }
        }

        await LoadAsync();
        _message = "User approved successfully.";
        _isError = false;
    }

    private async Task UpdateRoleAsync(UserRoleRow row)
    {
        _message = null;

        if (!_allowedRoles.Contains(row.SelectedRole))
        {
            _message = "Invalid role selection.";
            _isError = true;
            return;
        }

        var user = await UserManager.FindByIdAsync(row.UserId);
        if (user is null)
        {
            _message = "User not found.";
            _isError = true;
            return;
        }

        var existingRoles = await UserManager.GetRolesAsync(user);
        var appRoles = existingRoles.Where(r => _allowedRoles.Contains(r)).ToList();

        var isCurrentlyAdmin = appRoles.Contains("Admin");
        var isDemotingAdmin = isCurrentlyAdmin && row.SelectedRole != "Admin";

        if (isDemotingAdmin)
        {
            var admins = await UserManager.GetUsersInRoleAsync("Admin");
            if (admins.Count <= 1)
            {
                _message = "Cannot remove the last remaining Admin account.";
                _isError = true;
                return;
            }
        }

        var rolesToRemove = appRoles.Where(r => r != row.SelectedRole).ToArray();
        if (rolesToRemove.Length > 0)
        {
            var removeResult = await UserManager.RemoveFromRolesAsync(user, rolesToRemove);
            if (!removeResult.Succeeded)
            {
                _message = string.Join(", ", removeResult.Errors.Select(e => e.Description));
                _isError = true;
                return;
            }
        }

        if (!appRoles.Contains(row.SelectedRole))
        {
            var addResult = await UserManager.AddToRoleAsync(user, row.SelectedRole);
            if (!addResult.Succeeded)
            {
                _message = string.Join(", ", addResult.Errors.Select(e => e.Description));
                _isError = true;
                return;
            }
        }

        await LoadAsync();
        _message = "User role updated.";
        _isError = false;
    }

    private sealed class UserRoleRow
    {
        public string UserId { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool EmailConfirmed { get; set; }
        public string CurrentRolesDisplay { get; set; } = "None";
        public string SelectedRole { get; set; } = "User";
    }
}
