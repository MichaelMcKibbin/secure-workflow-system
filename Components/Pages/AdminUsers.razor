@page "/admin/users"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Policy = "CanManageUsers")]
@inject UserManager<secure_workflow_system.Data.ApplicationUser> UserManager

<PageTitle>Manage Users</PageTitle>

<h1>Manage Users</h1>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

@if (_rows is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Current Role</th>
                <th>Set Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td>@row.Email</td>
                    <td>@row.CurrentRole</td>
                    <td>
                        <EditForm Model="row" OnValidSubmit="() => UpdateRoleAsync(row)" FormName="@($"ManageUserRole_{row.UserId}")">
                            <InputSelect class="form-select d-inline-block w-auto me-2" @bind-Value="row.SelectedRole">
                                @foreach (var role in _roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                            <button type="submit" class="btn btn-sm btn-primary">Save</button>
                        </EditForm>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly string[] _roles = ["User", "Staff", "Admin"];
    private List<UserRoleRow>? _rows;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _rows = [];

        var users = await UserManager.Users
            .OrderBy(u => u.Email)
            .ToListAsync();

        foreach (var user in users)
        {
            var userRoles = await UserManager.GetRolesAsync(user);
            var currentRole = userRoles.FirstOrDefault(r => _roles.Contains(r)) ?? "None";

            _rows.Add(new UserRoleRow
            {
                UserId = user.Id,
                Email = user.Email ?? user.UserName ?? user.Id,
                CurrentRole = currentRole,
                SelectedRole = currentRole == "None" ? "User" : currentRole
            });
        }
    }

    private async Task UpdateRoleAsync(UserRoleRow row)
    {
        _message = null;

        var user = await UserManager.FindByIdAsync(row.UserId);
        if (user is null)
        {
            _message = "User not found.";
            _isError = true;
            return;
        }

        var existingRoles = await UserManager.GetRolesAsync(user);
        var rolesToRemove = existingRoles.Where(r => _roles.Contains(r)).ToArray();

        if (rolesToRemove.Length > 0)
        {
            var removeResult = await UserManager.RemoveFromRolesAsync(user, rolesToRemove);
            if (!removeResult.Succeeded)
            {
                _message = string.Join(", ", removeResult.Errors.Select(e => e.Description));
                _isError = true;
                return;
            }
        }

        var addResult = await UserManager.AddToRoleAsync(user, row.SelectedRole);
        if (!addResult.Succeeded)
        {
            _message = string.Join(", ", addResult.Errors.Select(e => e.Description));
            _isError = true;
            return;
        }

        await LoadAsync();
        _message = "User role updated.";
        _isError = false;
    }

    private sealed class UserRoleRow
    {
        public string UserId { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string CurrentRole { get; set; } = "None";
        public string SelectedRole { get; set; } = "User";
    }
}
