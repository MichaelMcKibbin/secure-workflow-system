@page "/cases"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "CanViewCases")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject secure_workflow_system.Services.ICaseService CaseService

<PageTitle>Cases</PageTitle>

<div class="section-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2>@(_isStaffOrAdmin ? "📋 All Cases" : "📋 My Cases")</h2>
            <p class="section-subheader">@(_isStaffOrAdmin ? "View all cases in the system" : "View your assigned cases")</p>
        </div>
        <div class="layout-toggle" role="group" aria-label="Layout options">
            <button class="btn @(_isListLayout ? "btn-outline-primary" : "btn-primary") btn-sm" 
                    @onclick="SwitchToCardLayout"
                    title="Card view">
                📇 Cards
            </button>
            <button class="btn @(_isListLayout ? "btn-primary" : "btn-outline-primary") btn-sm" 
                    @onclick="SwitchToListLayout"
                    title="List view">
                📋 List
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_cases is null)
{
    <p>Loading...</p>
}
else if (_cases.Count == 0)
{
    <div class="alert alert-info">
        <p class="mb-0">No cases found. @(_isStaffOrAdmin ? "" : "When cases are assigned to you, they will appear here.")</p>
    </div>
}
else
{
    @if (_isListLayout)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var workflowCase in _cases)
                    {
                        <tr class="case-list-row">
                            <td>
                                <a href="@($"/cases/{workflowCase.Id}")" class="text-decoration-none">
                                    #@workflowCase.Id
                                </a>
                            </td>
                            <td>
                                <a href="@($"/cases/{workflowCase.Id}")" class="text-decoration-none">
                                    @workflowCase.Title
                                </a>
                            </td>
                            <td>
                                <span class="badge @GetBadgeClass(workflowCase.Status)">@FormatStatus(workflowCase.Status)</span>
                            </td>
                            <td>@($"{workflowCase.CreatedAtUtc:g} UTC")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var workflowCase in _cases)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <a href="@($"/cases/{workflowCase.Id}")" class="text-decoration-none">
                        <div class="case-card fade-in status-@GetStatusClass(workflowCase.Status)">
                            <h5>@workflowCase.Title</h5>
                            <p class="case-meta mb-2">
                                <span class="badge @GetBadgeClass(workflowCase.Status)">@FormatStatus(workflowCase.Status)</span>
                            </p>
                            <p class="case-meta mb-1">
                                <strong>ID:</strong> #@workflowCase.Id
                            </p>
                            <p class="case-meta">
                                <strong>Created:</strong> @($"{workflowCase.CreatedAtUtc:g} UTC")
                            </p>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<secure_workflow_system.Data.Case>? _cases;
    private string? _errorMessage;
    private bool _isStaffOrAdmin;
    private bool _isListLayout = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(userId))
        {
            _errorMessage = "Unable to determine the current user.";
            _cases = [];
            return;
        }

        _isStaffOrAdmin = user.IsInRole("Staff") || user.IsInRole("Admin");

        try
        {
            _cases = _isStaffOrAdmin
                ? await CaseService.GetAllCasesAsync()
                : await CaseService.GetCasesForUserAsync(userId);
        }
        catch
        {
            _errorMessage = "Unable to load cases right now. Please try again.";
            _cases = [];
        }
    }

    private string FormatStatus(secure_workflow_system.Data.WorkflowState status)
    {
        return status.ToString().Replace("InProgress", "In Progress");
    }

    private string GetStatusClass(secure_workflow_system.Data.WorkflowState status)
    {
        return status switch
        {
            secure_workflow_system.Data.WorkflowState.New => "open",
            secure_workflow_system.Data.WorkflowState.Assigned => "pending",
            secure_workflow_system.Data.WorkflowState.InProgress => "pending",
            secure_workflow_system.Data.WorkflowState.Resolved => "closed",
            secure_workflow_system.Data.WorkflowState.Closed => "closed",
            _ => "open"
        };
    }

    private string GetBadgeClass(secure_workflow_system.Data.WorkflowState status)
    {
        return status switch
        {
            secure_workflow_system.Data.WorkflowState.New => "badge-info",
            secure_workflow_system.Data.WorkflowState.Assigned => "badge-warning",
            secure_workflow_system.Data.WorkflowState.InProgress => "badge-warning",
            secure_workflow_system.Data.WorkflowState.Resolved => "badge-success",
            secure_workflow_system.Data.WorkflowState.Closed => "badge-danger",
            _ => "badge-secondary"
        };
    }

    private void SwitchToCardLayout()
    {
        _isListLayout = false;
    }

    private void SwitchToListLayout()
    {
        _isListLayout = true;
    }
}
