@page "/cases/{Id:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@attribute [Authorize(Policy = "CanViewCases")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<secure_workflow_system.Data.ApplicationUser> UserManager
@inject secure_workflow_system.Services.ICaseService CaseService

<PageTitle>Case Details</PageTitle>

<h1>Case Details</h1>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success" role="alert">@_successMessage</div>
}

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (_case is null)
{
    <p>Case not found.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@_case.Id</dd>

        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@_case.Title</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@_case.Description</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@FormatStatus(_case.Status)</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@_case.CreatedByUserId</dd>

        <dt class="col-sm-3">Assigned To</dt>
        <dd class="col-sm-9">@(_case.AssignedToUserId ?? "Unassigned")</dd>

        <dt class="col-sm-3">Created (UTC)</dt>
        <dd class="col-sm-9">@_case.CreatedAtUtc.ToString("u")</dd>

        <dt class="col-sm-3">Updated (UTC)</dt>
        <dd class="col-sm-9">@FormatUpdatedTime()</dd>
    </dl>

    @if (_canManageCases)
    {
        <h3>Manage Case</h3>
        <EditForm Model="_manageModel" OnValidSubmit="HandleManageSubmitAsync" FormName="ManageCaseForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label" for="status">Status</label>
                <InputSelect id="status" class="form-select" @bind-Value="_manageModel.Status">
                    @foreach (var status in GetValidTransitions())
                    {
                        <option value="@status.ToString()">@FormatStatus(status)</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label" for="assignedTo">Assigned To</label>
                <InputSelect id="assignedTo" class="form-select" @bind-Value="_manageModel.AssignedToUserId">
                    <option value="">Unassigned</option>
                    @foreach (var user in _assignableUsers)
                    {
                        <option value="@user.Id">@user.Display</option>
                    }
                </InputSelect>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_isSaving">@(_isSaving ? "Saving..." : "Save")</button>
        </EditForm>
    }

    <h3 class="mt-4">Status History</h3>
    @if (_statusHistory.Count == 0)
    {
        <p><em>No status changes recorded yet.</em></p>
    }
    else
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>From</th>
                    <th>To</th>
                    <th>Changed By</th>
                    <th>Changed At (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var history in _statusHistory)
                {
                    <tr>
                        <td>@FormatStatus(history.OldStatus)</td>
                        <td>@FormatStatus(history.NewStatus)</td>
                        <td>@history.ChangedByUserId</td>
                        <td>@history.ChangedAtUtc.ToString("u")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private secure_workflow_system.Data.Case? _case;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canManageCases;
    private string? _currentUserId;
    private string? _errorMessage;
    private string? _successMessage;
    private readonly ManageCaseInputModel _manageModel = new();
    private readonly List<UserOption> _assignableUsers = [];
    private readonly List<secure_workflow_system.Data.CaseStatusHistory> _statusHistory = [];

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            _errorMessage = "Unable to determine the current user.";
            _case = null;
            _isLoading = false;
            return;
        }

        _canManageCases = user.IsInRole("Staff") || user.IsInRole("Admin");

        try
        {
            _case = _canManageCases
                ? await CaseService.GetCaseByIdAsync(Id)
                : await CaseService.GetCaseByIdForUserAsync(Id, _currentUserId);

            if (_case is not null)
            {
                if (_canManageCases)
                {
                    _manageModel.Status = _case.Status.ToString();
                    _manageModel.AssignedToUserId = _case.AssignedToUserId;
                    await LoadAssignableUsersAsync();
                }

                _statusHistory.Clear();
                var history = await CaseService.GetCaseStatusHistoryAsync(_case.Id);
                _statusHistory.AddRange(history);
            }
        }
        catch
        {
            _errorMessage = "Unable to load this case right now. Please try again.";
            _case = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAssignableUsersAsync()
    {
        _assignableUsers.Clear();

        var userRoleUsers = await UserManager.GetUsersInRoleAsync("User");
        var staffUsers = await UserManager.GetUsersInRoleAsync("Staff");
        var adminUsers = await UserManager.GetUsersInRoleAsync("Admin");

        foreach (var user in userRoleUsers
            .Concat(staffUsers)
            .Concat(adminUsers)
            .GroupBy(u => u.Id)
            .Select(g => g.First())
            .OrderBy(u => u.Email ?? u.UserName ?? u.Id))
        {
            _assignableUsers.Add(new UserOption(user.Id, user.Email ?? user.UserName ?? user.Id));
        }
    }

    private async Task HandleManageSubmitAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        if (!_canManageCases || _case is null)
        {
            _errorMessage = "You are not authorized to update this case.";
            return;
        }

        try
        {
            _isSaving = true;
            var updated = await CaseService.UpdateCaseStatusAndAssignmentAsync(
                _case.Id,
                _manageModel.Status,
                _manageModel.AssignedToUserId,
                _currentUserId!);

            if (!updated)
            {
                _errorMessage = "Case not found or invalid status transition.";
                return;
            }

            _case = await CaseService.GetCaseByIdAsync(_case.Id);

            _statusHistory.Clear();
            var history = await CaseService.GetCaseStatusHistoryAsync(_case.Id);
            _statusHistory.AddRange(history);

            _successMessage = "Case updated successfully.";
        }
        catch
        {
            _errorMessage = "Unable to update the case right now. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string FormatUpdatedTime()
    {
        if (_case == null)
            return string.Empty;

        DateTime dateTime = _case.UpdatedAtUtc ?? _case.CreatedAtUtc;
        return dateTime.ToString("u");
    }

    private string FormatStatus(secure_workflow_system.Data.WorkflowState status)
    {
        return status.ToString().Replace("InProgress", "In Progress");
    }

    private string FormatStatus(string status)
    {
        return status.Replace("InProgress", "In Progress");
    }

    private List<secure_workflow_system.Data.WorkflowState> GetValidTransitions()
    {
        if (_case is null)
            return new List<secure_workflow_system.Data.WorkflowState>();

        return Enum.GetValues(typeof(secure_workflow_system.Data.WorkflowState))
            .Cast<secure_workflow_system.Data.WorkflowState>()
            .Where(state => secure_workflow_system.Data.Case.IsValidTransition(_case.Status, state))
            .ToList();
    }

    private sealed class ManageCaseInputModel
    {
        [Required]
        public string Status { get; set; } = secure_workflow_system.Data.WorkflowState.New.ToString();

        public string? AssignedToUserId { get; set; }
    }

    private sealed record UserOption(string Id, string Display);
}
