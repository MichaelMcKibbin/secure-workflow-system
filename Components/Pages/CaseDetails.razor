@page "/cases/{Id:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@attribute [Authorize(Policy = "CanViewCases")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<secure_workflow_system.Data.ApplicationUser> UserManager
@inject secure_workflow_system.Services.ICaseService CaseService

<PageTitle>Case Details</PageTitle>

<div class="section-header">
    <h2>Case Details</h2>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success" role="alert">@_successMessage</div>
}

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (_case is null)
{
    <p>Case not found.</p>
}
else
{
    <div class="card mb-4 fade-in">
        <div class="card-header">
            <h5 class="card-title mb-0">📋 Case Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-primary fw-bold">Title</h6>
                    <p>@_case.Title</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-primary fw-bold">Status</h6>
                    <p>@GetStatusBadge(_case.Status)</p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <h6 class="text-primary fw-bold">Description</h6>
                    <p>@_case.Description</p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <h6 class="text-primary fw-bold">Case ID</h6>
                    <p class="text-muted">@_case.Id</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-primary fw-bold">Created By</h6>
                    <p class="text-muted">@_case.CreatedByUser?.UserName</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-primary fw-bold">Assigned To</h6>
                    <p class="text-muted">@(_case.AssignedToUser?.UserName ?? "Unassigned")</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-primary fw-bold">Created</h6>
                    <p class="text-muted">@_case.CreatedAtUtc.ToString("g")</p>
                </div>
            </div>
            @if (_case.UpdatedAtUtc.HasValue)
            {
                <div class="row">
                    <div class="col-md-3">
                        <h6 class="text-primary fw-bold">Last Updated</h6>
                        <p class="text-muted">@_case.UpdatedAtUtc.Value.ToString("g")</p>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (_canManageCases)
    {
        <div class="card mb-4 fade-in">
            <div class="card-header">
                <h5 class="card-title mb-0">⚙️ Manage Case</h5>
            </div>
            <div class="card-body">
                <EditForm Model="_manageModel" OnValidSubmit="HandleManageSubmitAsync" FormName="ManageCaseForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="mb-3">
                        <label class="form-label" for="status">Status</label>
                        <InputSelect id="status" class="form-select" @bind-Value="_manageModel.Status">
                            @foreach (var status in GetValidTransitions())
                            {
                                <option value="@status.ToString()">@FormatStatus(status)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="assignedTo">Assigned To</label>
                        <InputSelect id="assignedTo" class="form-select" @bind-Value="_manageModel.AssignedToUserId">
                            <option value="">Unassigned</option>
                            @foreach (var user in _assignableUsers)
                            {
                                <option value="@user.Id">@user.Display</option>
                            }
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>💾 Save Changes</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>
    }

    <div class="card fade-in">
        <div class="card-header">
            <h5 class="card-title mb-0">📜 Status History</h5>
        </div>
        <div class="card-body">
            @if (_statusHistory.Count == 0)
            {
                <p class="text-muted"><em>No status changes recorded yet.</em></p>
            }
            else
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                            <th>Changed By</th>
                            <th>Changed At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var history in _statusHistory)
                        {
                            <tr>
                                <td>@GetStatusBadgeFromString(history.OldStatus)</td>
                                <td>@GetStatusBadgeFromString(history.NewStatus)</td>
                                <td>@history.ChangedByUser?.UserName</td>
                                <td>@history.ChangedAtUtc.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private secure_workflow_system.Data.Case? _case;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canManageCases;
    private string? _currentUserId;
    private string? _errorMessage;
    private string? _successMessage;
    private readonly ManageCaseInputModel _manageModel = new();
    private readonly List<UserOption> _assignableUsers = [];
    private readonly List<secure_workflow_system.Data.CaseStatusHistory> _statusHistory = [];

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            _errorMessage = "Unable to determine the current user.";
            _case = null;
            _isLoading = false;
            return;
        }

        _canManageCases = user.IsInRole("Staff") || user.IsInRole("Admin");

        try
        {
            _case = _canManageCases
                ? await CaseService.GetCaseByIdAsync(Id)
                : await CaseService.GetCaseByIdForUserAsync(Id, _currentUserId);

            if (_case is not null)
            {
                if (_canManageCases)
                {
                    _manageModel.Status = _case.Status.ToString();
                    _manageModel.AssignedToUserId = _case.AssignedToUserId;
                    await LoadAssignableUsersAsync();
                }

                _statusHistory.Clear();
                var history = await CaseService.GetCaseStatusHistoryAsync(_case.Id);
                _statusHistory.AddRange(history);
            }
        }
        catch
        {
            _errorMessage = "Unable to load this case right now. Please try again.";
            _case = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAssignableUsersAsync()
    {
        _assignableUsers.Clear();

        var userRoleUsers = await UserManager.GetUsersInRoleAsync("User");
        var staffUsers = await UserManager.GetUsersInRoleAsync("Staff");
        var adminUsers = await UserManager.GetUsersInRoleAsync("Admin");

        foreach (var user in userRoleUsers
            .Concat(staffUsers)
            .Concat(adminUsers)
            .GroupBy(u => u.Id)
            .Select(g => g.First())
            .OrderBy(u => u.Email ?? u.UserName ?? u.Id))
        {
            _assignableUsers.Add(new UserOption(user.Id, user.Email ?? user.UserName ?? user.Id));
        }
    }

    private async Task HandleManageSubmitAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        if (!_canManageCases || _case is null)
        {
            _errorMessage = "You are not authorized to update this case.";
            return;
        }

        try
        {
            _isSaving = true;
            var updated = await CaseService.UpdateCaseStatusAndAssignmentAsync(
                _case.Id,
                _manageModel.Status,
                _manageModel.AssignedToUserId,
                _currentUserId!);

            if (!updated)
            {
                _errorMessage = "Case not found or invalid status transition.";
                return;
            }

            _case = await CaseService.GetCaseByIdAsync(_case.Id);

            _statusHistory.Clear();
            var history = await CaseService.GetCaseStatusHistoryAsync(_case.Id);
            _statusHistory.AddRange(history);

            _successMessage = "Case updated successfully.";
        }
        catch
        {
            _errorMessage = "Unable to update the case right now. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string FormatUpdatedTime()
    {
        if (_case == null)
            return string.Empty;

        DateTime dateTime = _case.UpdatedAtUtc ?? _case.CreatedAtUtc;
        return dateTime.ToString("u");
    }

    private string FormatStatus(secure_workflow_system.Data.WorkflowState status)
    {
        return status.ToString().Replace("InProgress", "In Progress");
    }

    private string FormatStatus(string status)
    {
        return status.Replace("InProgress", "In Progress");
    }

    private List<secure_workflow_system.Data.WorkflowState> GetValidTransitions()
    {
        if (_case is null)
            return new List<secure_workflow_system.Data.WorkflowState>();

        return Enum.GetValues(typeof(secure_workflow_system.Data.WorkflowState))
            .Cast<secure_workflow_system.Data.WorkflowState>()
            .Where(state => secure_workflow_system.Data.Case.IsValidTransition(_case.Status, state))
            .ToList();
    }

    private MarkupString GetStatusBadge(secure_workflow_system.Data.WorkflowState status)
    {
        var badgeClass = status switch
        {
            secure_workflow_system.Data.WorkflowState.New => "badge badge-info",
            secure_workflow_system.Data.WorkflowState.Assigned => "badge badge-info",
            secure_workflow_system.Data.WorkflowState.InProgress => "badge badge-warning",
            secure_workflow_system.Data.WorkflowState.Resolved => "badge badge-success",
            secure_workflow_system.Data.WorkflowState.Closed => "badge badge-danger",
            _ => "badge badge-secondary"
        };

        var statusText = FormatStatus(status);
        return new MarkupString($"<span class=\"{badgeClass}\">{statusText}</span>");
    }

    private MarkupString GetStatusBadgeFromString(string statusStr)
    {
        if (Enum.TryParse<secure_workflow_system.Data.WorkflowState>(statusStr, out var status))
        {
            return GetStatusBadge(status);
        }

        var badgeClass = "badge badge-secondary";
        var encodedStatusStr = System.Text.Encodings.Web.HtmlEncoder.Default.Encode(statusStr);
        return new MarkupString($"<span class=\"{badgeClass}\">{encodedStatusStr}</span>");
    }

    private sealed class ManageCaseInputModel
    {
        [Required]
        public string Status { get; set; } = secure_workflow_system.Data.WorkflowState.New.ToString();

        public string? AssignedToUserId { get; set; }
    }

    private sealed record UserOption(string Id, string Display);
}
